    "At a timber bridge each chick carries straight on. Connect both sides of each crossing.": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At a timber bridge each chick carries straight on. Connect both sides of each crossing."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعبر الكتاكيت الجسر الخشبي في خط مستقيم. صِل طرفَي كل معبر."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小雞會直直穿過木橋。把每個交叉口的兩端接起來。"
          }
        }
      }
    },
